# Copy to .env.local. Share these two values with ALL THREE teams.
#
# NOTE: this project uses Supabase's NEW key format (sb_publishable_...), not the
# legacy anon JWT. The variable is *_PUBLISHABLE_KEY, not *_ANON_KEY. Getting this
# name wrong is a silent undefined at runtime, so copy it exactly.
#
# The publishable key is designed to be shipped in clients and is safe in a public
# repo. A service-role / secret key is NOT needed anywhere in FlowPilot — if you
# find yourself wanting one in a client, stop.

# --- Web (Next.js: Control + Desk) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# --- Mobile (Expo: FlowPilot Visitor) --- same two values, EXPO_PUBLIC_ prefix
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# --- Server-side only. NEVER prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_. ---
GEMINI_API_KEY=
