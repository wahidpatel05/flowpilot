# Copy to .env.local in THIS directory (flowpilot-visitor/), then restart the
# bundler — Expo inlines EXPO_PUBLIC_* at build time, so a running bundler will
# not pick up a change here.
#
# Same two values the web team uses, with the EXPO_PUBLIC_ prefix. Note the key
# is *_PUBLISHABLE_KEY (new Supabase format, starts sb_publishable_), NOT
# *_ANON_KEY — the wrong name is a silent undefined at runtime. The publishable
# key is designed to ship in a client bundle; no service-role key belongs here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
